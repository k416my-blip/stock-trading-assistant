# Local native trees — EAS uses app.json + prebuild (managed workflow)
# Root-only: bare `android/` would also exclude modules/sta-native-runtime/android/
/android/
/ios/

# Dev / audit artifacts (not needed in cloud build)
.expo/
.expo-bundle-*/
scripts/monitor*.json
scripts/monitor*.csv
agent-tools/
agent-transcripts/

# Local module Gradle outputs (keep uploads lean; source is in git)
modules/sta-native-runtime/android/build/

# Review evidence / large local artifacts (not needed for cloud build)
docs/review/
docs/
artifacts/
!artifacts/.gitkeep

# Unit tests and dev scripts (not needed in production bundle)
/tests/
/scripts/
!scripts/sync-sta-native-runtime.mjs
/src/tooling/
/.cursor/
