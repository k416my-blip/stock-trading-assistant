# Secrets
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Heavy / generated (Cursor indexing & file watchers)
node_modules/
.expo/
.expo-shared/
dist/
build/
coverage/
.cache/
metro-cache/
.turbo/
.next/
logs/
tmp/
temp/
generated/
web-build/
.nyc_output/
reports/
artifacts/
screenshots/
playwright-report/
test-results/
agent-tools/
agent-transcripts/

# Native / platform trees
android/
ios/

# Logs & debug artifacts
.expo-*-log.txt
*.log
*.tmp
*.map
*.tsbuildinfo
audit-out.txt
.verify-*
*.qr.png
expo-go-qr.png

# Git / IDE internals
.git/
.cursor/
**/.cursor/projects/

# Lock files (large, rarely edited)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Offline verify / tooling scripts (not app runtime; run via tsx)
src/verify/
src/tooling/
src/native/soak/generated/

# Misc backups
*.bak
*.backup
*.orig
*~


# ── Cursor performance: exclude review evidence & audit scripts ──
# docs/review alone is 7000+ files / ~11GB — major Cursor slowdown source
docs/
scripts/

# Play Store / device binaries
*.aab
*.apk

# Device capture evidence
**/*-device/
**/hyperos-*/
**/logcat*.txt
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.xml
!assets/**
!android/app/src/main/res/**
