{
  "name": "stock-trading-assistant",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npx tsx src/verify/runRelease.verify.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/recovery tests/execution tests/persistence",
    "verify:integration": "npx tsx src/verify/integration.verify.ts",
    "verify:diagnostics": "npx tsx src/verify/diagnostics.verify.ts",
    "verify:release": "npx tsx src/verify/release.verify.ts",
    "verify:portfolio": "npx tsx src/verify/portfolioStability.verify.ts",
    "verify:market-data": "npx tsx src/verify/marketDataErrors.verify.ts",
    "verify:quote-providers": "npx tsx src/verify/quoteProvidersLive.verify.ts",
    "verify:market-boundary": "npx tsx src/verify/marketDataBoundary.verify.ts",
    "verify:recovery": "npx tsx src/verify/portfolioRecovery.verify.ts",
    "verify:queue": "npx tsx src/verify/marketDataQueue.verify.ts",
    "verify:execution": "npx tsx src/verify/executionSafety.verify.ts",
    "verify:security": "npx tsx src/verify/security.verify.ts",
    "verify:personal-production": "npx tsx src/verify/personalProduction.verify.ts",
    "verify:ai-strategy": "npx tsx src/verify/aiStrategy.verify.ts",
    "verify:x-bearer": "npx tsx src/verify/xBearerAuth.verify.ts",
    "verify:full-audit": "npx tsx src/verify/fullAudit.verify.ts",
    "verify:redmi-soak": "npx tsx src/verify/redmiLongSoak.verify.ts",
    "verify:post-soak": "npx vitest run tests/unit/nativeBoundary/postSoakFailureAnalysis.test.ts",
    "verify:causal-graph": "npx vitest run tests/unit/runtimeAnalysis/runtimeCausalGraph.test.ts",
    "verify:temporal-causality": "npx vitest run tests/unit/runtimeAnalysis/runtimeTemporalCausality.test.ts",
    "verify:latent-state": "npx vitest run tests/unit/runtimeAnalysis/runtimeLatentStateInference.test.ts",
    "verify:hierarchical-latent": "npx vitest run tests/unit/runtimeAnalysis/hierarchicalLatentRuntimeGraph.test.ts",
    "verify:adaptive-runtime": "npx vitest run tests/unit/runtimeAnalysis/adaptiveRuntimeLearning.test.ts",
    "verify:adaptive-governance": "npx vitest run tests/unit/runtimeGovernance/adaptiveRuntimeGovernance.test.ts",
    "verify:observability": "npx vitest run tests/unit/runtimeObservability",
    "verify:self-healing": "npx vitest run tests/unit/runtimeSelfHealing",
    "verify:evolution": "npx vitest run tests/unit/runtimeEvolution",
    "verify:constitution": "npx vitest run tests/unit/runtimeConstitution",
    "verify:metabolism": "npx vitest run tests/unit/runtimeMetabolism",
    "verify:curiosity": "npx vitest run tests/unit/runtimeCuriosity",
    "verify:unified-orchestrator": "npx vitest run tests/unit/runtimeUnifiedOrchestrator",
    "verify:longevity": "npx vitest run tests/unit/runtimeLongevity",
    "verify:runtime-stress": "npx vitest run tests/unit/runtimeStress && npx tsx src/verify/runtimeLongSessionStress.verify.ts",
    "verify:native-telemetry": "npx vitest run tests/unit/nativeTelemetry && npx tsx src/verify/nativeDeviceTelemetry.verify.ts",
    "verify:soak-runner": "npx vitest run tests/unit/nativeSoak && npx tsx src/verify/automatedSoakRunner.verify.ts",
    "verify:telemetry-overhead": "npx vitest run tests/unit/telemetryOverhead && npx tsx src/verify/telemetryOverhead.verify.ts",
    "verify:js-thread-stabilization": "npx vitest run tests/unit/jsThreadStabilization && npx tsx src/verify/jsThreadStabilization.verify.ts",
    "verify:rn-bridge-survivability": "npx vitest run tests/unit/rnBridgeSurvivability && npx tsx src/verify/rnBridgeSurvivability.verify.ts",
    "verify:failure-recovery": "npx vitest run tests/unit/failureRecovery && npx tsx src/verify/failureRecovery.verify.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-haptics": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "sta-native-runtime": "file:./modules/sta-native-runtime"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^55.0.21",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
