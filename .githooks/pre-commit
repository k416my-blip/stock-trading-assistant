#!/bin/sh
# Install: git config core.hooksPath .githooks
# Runs PowerShell hook (works on Windows Git for Windows + macOS/Linux with pwsh)

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"

if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$HOOK_DIR/pre-commit.ps1"
fi

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$HOOK_DIR/pre-commit.ps1"
fi

echo "pre-commit: powershell not found; cannot run secret scan hook."
exit 1
