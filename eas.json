{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_TWELVE_HOUR_TEST_MONITOR": ""
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_TWELVE_HOUR_TEST_MONITOR": "1"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    },
    "apk": {
      "distribution": "internal",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_TWELVE_HOUR_TEST_MONITOR": ""
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    }
  },
  "submit": {
    "production": {
      "android": {}
    }
  }
}
